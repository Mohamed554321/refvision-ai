# RefVision AI Environment Configuration
# $0 Zero-Cost Default: Works 100% locally without any external API keys

PROJECT_NAME=RefVision AI
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Microsoft Agent Framework / Azure AI Foundry Configuration (Optional)
# Leave blank to use the high-fidelity offline deterministic multi-agent provider
AZURE_AI_FOUNDRY_ENDPOINT=
AZURE_AI_FOUNDRY_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_AGENT_SERVICE_VERSION=2024-05-01-preview

# Local Model Provider (Optional, e.g., Ollama)
LOCAL_LLM_ENDPOINT=http://localhost:11434

# Simulation Configuration
DEFAULT_SIMULATION_SEED=MATCH_PL_2026_01
SIMULATION_SPEED_MULTIPLIER=1.0
